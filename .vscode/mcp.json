{
  // For more information, visit: https://angular.dev/ai/mcp
  //
  // Pinned to the Angular 22 range this workspace builds with, so the server's
  // guidance and migrations match the installed CLI instead of floating to
  // whatever npm serves. Angular 22 registers `run_target` and the `devserver.*`
  // tools by default; the old `--experimental-tool` / `-E` flags were removed.
  "servers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli@^22.2.1", "mcp"]
    }
  }
}
