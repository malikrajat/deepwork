{
  "name": "deepwork-app",
  "version": "2.0.17",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4999",
    "build:github": "ng build  --base-href=/deepwork/ --configuration production",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/bump-version.mjs --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run test && npm run build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "build:mac": "tauri build --target x86_64-apple-darwin",
    "build:mac-arm": "tauri build --target aarch64-apple-darwin",
    "build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:open": "playwright show-report || playwright test --output=playwright-report"
  },
  "private": true,
  "description": "DeepWork — a cross-platform focus timer and task manager built with Tauri 2 and Angular, keeping its database and its analysis on your own machine.",
  "license": "MIT",
  "author": "Rajat Malik",
  "homepage": "https://github.com/malikrajat/deepwork",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malikrajat/deepwork.git"
  },
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@lucide/angular": "^1.50.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "rm-ng-export-to-csv": "^5.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.19.1",
    "@vitest/coverage-istanbul": "^5.0.3",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "fast-glob": "^3.3.3",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
